# The version of the HakiOS kernel, given the way the Makefile of Linux and an Android kernel give theirs:
#
#   VERSION.PATCHLEVEL.SUBLEVEL EXTRAVERSION
#
# tools/kernel-version.py makes the whole string from this file, the active configuration (.config) and
# git: 2.3.4-hakios-darwin22.5-sc7280-g1a2b3c4d  (the version, EXTRAVERSION, the Darwin it is built on, the
# SoC family the configuration is for, and the commit; "-dirty" when the tracked files have changed).
# The loader prints it as kernel.ver= under its banner, passes it to the kernel as the boot-arg hakios_kver,
# and the kernel keeps it as sysctl kern.hakios.version. docs/versioning.md says when each number moves.
#
# VERSION    major: a change that breaks what a user, a port or a boot image relies on (the payload format, the
#            boot-arguments, the layout of the partition `darwin`)
# PATCHLEVEL a feature: a driver, a device, a tool
# SUBLEVEL   a fix
# EXTRAVERSION is what the tree is called; a vendor's branch says so here (Android's "-android12-9")
VERSION = 2
PATCHLEVEL = 3
SUBLEVEL = 4
EXTRAVERSION = -hakios
NAME = Hello Darwin

# the Darwin this kernel is built on: Apple's open xnu tag (xnu/apply.sh fetches it)
DARWIN = 22.5.0
XNU = xnu-8796.121.2
