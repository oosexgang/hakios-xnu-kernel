# RAM-only Redwood boot menu. No slot state or partition changes are made.
hakios_start=run hakios_menu
hakios_menu=bootmenu -1
bootmenu_0=Start XNU loader=hakios boot; pause
bootmenu_1=USB serial console=run serial_gadget; pause
bootmenu_2=U-Boot fastboot=run hakios_fastboot
bootmenu_3=Drop to U-Boot shell=setenv bootretry -1
bootmenu_4=Reset device=reset
