/dts-v1/;

// Shared SoC data for Snapdragon 8 Gen 5. Add register blocks with their backends.
/ {
	name = "sm8845";
	description = "Qualcomm Snapdragon 8 Gen 5 (SM8845)";

	// Channel used by the Ace 6T SM8845 reference port.
	scmi-perf {
		shmem = <0x81f08100>;
		mailbox = <0x19980000>;
		doorbell = <0x104>;
	};
	// TSENS v2, reg "tm" of tsens0..tsens6 in the Ace 6T's Android device tree (SROT at 0x0c222000..0x0c228000
	// is not needed: the hardware gives calibrated readings). Read only.
	thermal {
		tsens = <0x0c229000 0x0c22a000 0x0c22b000 0x0c22c000 0x0c22d000 0x0c22e000 0x0c22f000>;
	};
};
