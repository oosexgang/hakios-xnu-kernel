+/*
+ * redwood: a shader's private memory into registers. The AIR frontend gives a Metal function's local
+ * arrays scratch memory, and CoreAnimation's passes loaded and stored it up to 17 times a pixel -- a
+ * full-screen pass of 12 ms on this Mali (26 October). Where every access is of one width and the
+ * array is small, it becomes an array variable indexed by offset / width; nir_lower_indirect_derefs
+ * turns a computed index into a choice among registers, and nir_lower_vars_to_ssa does the rest.
+ */
+#define REDWOOD_SCRATCH_MAX 64          /* elements: beyond this a choice costs more than memory */
+
+/* bits [shift, shift + width) of a 32-bit word, as a value `width` bits wide */
+static nir_def *
+redwood_word_part(nir_builder *b, nir_def *word, unsigned shift, unsigned width)
+{
+   nir_def *v = shift ? nir_ushr_imm(b, word, shift) : word;
+
+   return width == 32 ? v : nir_u2uN(b, v, width);
 }
 
+static bool
+redwood_scratch_to_regs(nir_shader *nir)
+{
+   nir_function_impl *impl = nir_shader_get_entrypoint(nir);
+   unsigned widths = 0;
+   bool computed = false;
+   const char *why = NULL;
+   char line[160];
+
+   if (nir->scratch_size == 0 || impl == NULL)
+      return false;
+   {
+      /* boot-arg scratchregs=0: left in memory, for telling what this pass changes */
+      static int off = -1;
+
+      if (off < 0) {
+         char args[1024] = "";
+         size_t n = sizeof(args) - 1;
+
+         off = sysctlbyname("kern.bootargs", args, &n, NULL, 0) == 0 && strstr(args, "scratchregs=0") != NULL;
+      }
+      if (off)
+         return false;
+   }
+   nir_foreach_block(block, impl) {
+      nir_foreach_instr(instr, block) {
+         if (instr->type != nir_instr_type_intrinsic)
+            continue;
+         nir_intrinsic_instr *intr = nir_instr_as_intrinsic(instr);
+         bool load = intr->intrinsic == nir_intrinsic_load_scratch;
+
+         if (!load && intr->intrinsic != nir_intrinsic_store_scratch)
+            continue;
+         unsigned w = load ? intr->def.bit_size : nir_src_bit_size(intr->src[0]);
+         nir_src *off = &intr->src[load ? 0 : 1];
+
+         if (w != 8 && w != 16 && w != 32)
+            why = "an access of 1 or 64 bits";
+         else if (nir_src_is_const(*off) && nir_src_as_uint(*off) % (w / 8) != 0)
+            why = "an access not aligned to its width";
+         widths |= w;
+         computed |= !nir_src_is_const(*off);
+      }
+   }
+   /*
+    * Words of 32 bits, always: narrower accesses are parts of a word, taken out with a shift and put in
+    * with a mask -- the backend has no proper 8-bit arithmetic, and an array of bytes in registers was
+    * the frame drawn wrong (26 October: icons as thin strips). A computed index needs one width of 32.
+    */
+   unsigned words = DIV_ROUND_UP(nir->scratch_size, 4);
+
+   if (why == NULL && computed && (widths != 32 || words > REDWOOD_SCRATCH_MAX))
+      why = "a computed index into an array of mixed widths or a large one";
+   snprintf(line, sizeof(line), "!rwm scratch %s: %u bytes, widths %#x, %s", nir->info.name ? nir->info.name : "?",
+            nir->scratch_size, widths, why ? why : "into registers");
+   sysctlbyname("kern.redwood.say", NULL, NULL, line, strlen(line));
+   if (why != NULL || widths == 0)
+      return false;
+
+   nir_variable *var = nir_local_variable_create(impl, glsl_array_type(glsl_uint_type(), words, 4), "redwood_scratch");
+   nir_builder b = nir_builder_create(impl);
+
+   nir_foreach_block(block, impl) {
+      nir_foreach_instr_safe(instr, block) {
+         if (instr->type != nir_instr_type_intrinsic)
+            continue;
+         nir_intrinsic_instr *intr = nir_instr_as_intrinsic(instr);
+         bool load = intr->intrinsic == nir_intrinsic_load_scratch;
+
+         if (!load && intr->intrinsic != nir_intrinsic_store_scratch)
+            continue;
+         b.cursor = nir_before_instr(instr);
+         unsigned w = load ? intr->def.bit_size : nir_src_bit_size(intr->src[0]);
+         nir_src *off = &intr->src[load ? 0 : 1];
+         nir_deref_instr *arr = nir_build_deref_var(&b, var);
+
+         if (!nir_src_is_const(*off)) {
+            /* (32 bits wide, every access: checked above) */
+            nir_def *first = nir_ushr_imm(&b, off->ssa, 2);
+
+            if (load) {
+               nir_def *c[NIR_MAX_VEC_COMPONENTS];
+
+               for (unsigned i = 0; i < intr->def.num_components; i++)
+                  c[i] = nir_load_deref(&b, nir_build_deref_array(&b, arr, nir_iadd_imm(&b, first, i)));
+               nir_def_replace(&intr->def, nir_vec(&b, c, intr->def.num_components));
+            } else {
+               for (unsigned i = 0; i < intr->src[0].ssa->num_components; i++) {
+                  if (nir_intrinsic_write_mask(intr) & (1u << i))
+                     nir_store_deref(&b, nir_build_deref_array(&b, arr, nir_iadd_imm(&b, first, i)),
+                                     nir_channel(&b, intr->src[0].ssa, i), 1);
+               }
+               nir_instr_remove(instr);
+            }
+            continue;
+         }
+
+         unsigned at = nir_src_as_uint(*off);
+
+         if (load) {
+            nir_def *c[NIR_MAX_VEC_COMPONENTS];
+
+            for (unsigned i = 0; i < intr->def.num_components; i++) {
+               unsigned byte = at + i * (w / 8);
+
+               c[i] = byte / 4 < words
+                         ? redwood_word_part(&b, nir_load_deref(&b, nir_build_deref_array_imm(&b, arr, byte / 4)),
+                                             (byte % 4) * 8, w)
+                         : nir_imm_intN_t(&b, 0, w);
+            }
+            nir_def_replace(&intr->def, nir_vec(&b, c, intr->def.num_components));
+         } else {
+            for (unsigned i = 0; i < intr->src[0].ssa->num_components; i++) {
+               unsigned byte = at + i * (w / 8), shift = (byte % 4) * 8;
+
+               if (!(nir_intrinsic_write_mask(intr) & (1u << i)) || byte / 4 >= words)
+                  continue;
+               nir_deref_instr *slot = nir_build_deref_array_imm(&b, arr, byte / 4);
+               nir_def *v = nir_u2u32(&b, nir_channel(&b, intr->src[0].ssa, i));
+
+               if (w < 32) {
+                  uint32_t mask = ((1u << w) - 1) << shift;
+                  nir_def *old = nir_load_deref(&b, slot);
+
+                  v = nir_ior(&b, nir_iand_imm(&b, old, ~mask), nir_ishl_imm(&b, nir_iand_imm(&b, v, (1u << w) - 1), shift));
+               }
+               nir_store_deref(&b, slot, v, 1);
+            }
+            nir_instr_remove(instr);
+         }
+      }
+   }
+   nir_metadata_preserve(impl, nir_metadata_none);
+   nir->scratch_size = 0;
+   return true;
+}
