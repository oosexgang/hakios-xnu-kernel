+   device->has_local = false;
+   result = tu_physical_device_init(device, instance);
+   if (result != VK_SUCCESS) {
+      vk_free(&instance->vk.alloc, device);
+      close(fd);
+      return result;
+   }
+   list_addtail(&device->vk.link, &instance->vk.physical_devices.list);
+   if (TU_DEBUG(STARTUP))
