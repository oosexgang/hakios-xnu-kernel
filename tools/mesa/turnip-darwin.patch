+#elif defined(__APPLE__) && defined(TU_HAS_MSM)
+   /* Darwin: no DRM nodes to list. The one GPU is the kernel's service HakiosGPU, which speaks msm's requests through
+    * the stand-in for libdrm (src/hakios-drm); its file descriptor means nothing but "the connection". */
+   struct tu_instance *instance =
