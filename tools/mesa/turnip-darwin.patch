+   struct tu_physical_device *device = NULL;
+   int fd = drmOpenWithType("msm", NULL, DRM_NODE_RENDER);
+   if (fd < 0)
+      return VK_ERROR_INCOMPATIBLE_DRIVER;
+   drmVersionPtr version = drmGetVersion(fd);
+   if (!version) {
+      close(fd);
