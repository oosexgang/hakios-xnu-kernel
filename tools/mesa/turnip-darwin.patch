 static VkResult
 msm_device_init(struct tu_device *dev)
 {
+#ifdef __APPLE__
+   /* no device node: a descriptor of the one connection to HakiosGPU (src/hakios-drm) */
+   int fd = drmOpenWithType("msm", NULL, DRM_NODE_RENDER);
+#else
    int fd = open(dev->physical_device->fd_path, O_RDWR | O_CLOEXEC);
+#endif
    if (fd < 0) {
       return vk_startup_errorf(
             dev->physical_device->instance, VK_ERROR_INITIALIZATION_FAILED,
@@ -674,15 +679,28 @@ msm_bo_init(struct tu_device *dev,
    return result;
 }
 
+#ifdef __APPLE__
+/* the host pointer an import of "fd" -1 is of (tu_AllocateMemory, VK_EXT_external_memory_host) */
+thread_local const void *tu_darwin_host_pointer;
+#endif
+
 static VkResult
 msm_bo_init_dmabuf(struct tu_device *dev,
                    struct tu_bo **out_bo,
                    uint64_t size,
                    int prime_fd)
 {
+#ifdef __APPLE__
+   /* the "fd" is an IOSurface's ID (src/hakios-drm): its size is the kernel's answer; -1, the pages at
+    * tu_darwin_host_pointer (VK_EXT_external_memory_host) */
+   struct hakios_drm_surface described = { .surface = (uint32_t) prime_fd };
+   off_t real_size = prime_fd < 0 ? (off_t) size
+                   : hakios_drm_surface(dev->fd, &described) == 0 ? (off_t) described.size : -1;
+#else
    /* lseek() to get the real size */
    off_t real_size = lseek(prime_fd, 0, SEEK_END);
    lseek(prime_fd, 0, SEEK_SET);
+#endif
    if (real_size < 0 || (uint64_t) real_size < size)
       return vk_error(dev, VK_ERROR_INVALID_EXTERNAL_HANDLE);
 
@@ -699,8 +717,20 @@ msm_bo_init_dmabuf(struct tu_device *dev,
    msm_vma_lock(dev);
 
    uint32_t gem_handle;
+#ifdef __APPLE__
+   int ret = prime_fd < 0 ? hakios_drm_user_memory(dev->fd, tu_darwin_host_pointer, size, &gem_handle)
+                          : drmPrimeFDToHandle(dev->fd, prime_fd, &gem_handle);
+   if (ret) {
+      static int said;
+      if (said++ < 8)
+         mesa_loge("import of %s %p (%llu bytes) refused: %s", prime_fd < 0 ? "host pages" : "IOSurface",
+                   prime_fd < 0 ? tu_darwin_host_pointer : (const void *) (uintptr_t) prime_fd,
+                   (unsigned long long) size, strerror(errno));
+   }
+#else
    int ret = drmPrimeFDToHandle(dev->fd, prime_fd,
                                 &gem_handle);
+#endif
    if (ret) {
       msm_vma_unlock(dev);
       u_rwlock_wrunlock(&dev->dma_bo_lock);
@@ -735,6 +765,12 @@ msm_bo_init_dmabuf(struct tu_device *dev,
 static VkResult
 msm_bo_map(struct tu_device *dev, struct tu_bo *bo, void *placed_addr)
 {
