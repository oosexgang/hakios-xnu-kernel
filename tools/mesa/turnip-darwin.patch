diff --git a/meson.build b/meson.build
index f055df1..457fe06 100644
--- a/meson.build
+++ b/meson.build
@@ -1716,7 +1716,7 @@ else
   # dependencies (such as vk-runtime) linking to it
   dep_libdrm = null_dep
 endif
-if host_machine.system() == 'darwin' and with_gallium_freedreno
+if host_machine.system() == 'darwin' and (with_gallium_freedreno or with_freedreno_vk)
   # No DRM on this system: freedreno's requests go to the kernel's driver through a stand-in
   # for libdrm (src/hakios-drm, put there by Darwin on redwood's tools/mk-mesa.sh; its one
   # source file is built with freedreno's drm layer, src/freedreno/drm).
diff --git a/src/freedreno/vulkan/meson.build b/src/freedreno/vulkan/meson.build
index d0a38c9..4f68424 100644
--- a/src/freedreno/vulkan/meson.build
+++ b/src/freedreno/vulkan/meson.build
@@ -101,6 +101,10 @@ if freedreno_kmds.contains('msm')
   tu_flags += '-DTU_HAS_MSM'
   libtu_files += files('tu_knl_drm_msm.cc', 'tu_knl_drm.cc')
   tu_deps += dep_libdrm
+  if host_machine.system() == 'darwin'
+    # the stand-in for libdrm (src/hakios-drm): msm's requests as calls of the kernel's IOKit user client
+    libtu_files += files('../../hakios-drm/hakios.drm.c')
+  endif
 endif
 
 if freedreno_kmds.contains('virtio')
@@ -181,7 +185,10 @@ libvulkan_freedreno = shared_library(
   c_args : [no_override_init_args, tu_flags],
   cpp_args : [tu_cpp_args, tu_flags],
   gnu_symbol_visibility : 'hidden',
-  link_args : [vulkan_icd_link_args, ld_args_bsymbolic, ld_args_gc_sections, ld_args_build_id],
+  # (Darwin: the entrypoint tables' weak references to what Turnip leaves to the common runtime are allowed
+  # undefined, as ELF lets them be, and come out NULL; UniXNU's Turnip does the same)
+  link_args : [vulkan_icd_link_args, ld_args_bsymbolic, ld_args_gc_sections, ld_args_build_id,
+               host_machine.system() == 'darwin' ? ['-Wl,-undefined,dynamic_lookup'] : []],
   link_depends : vulkan_icd_link_depends,
   install : true,
 )
