+/* One function of a .metallib, or one module's bitcode, through the AIR
+ * frontend. Function constants are all taken as zero: the command line has no
+ * pipeline to get them from, and a module that needs real values says so.
+ */
+static nir_shader *
+load_air(const char *filename, const char *entry)
+{
+   void *buf;
+   size_t size;
+   read_file(filename, &buf, &size);
+
+   const void *bitcode = buf;
+   size_t bitcode_size = size;
+   struct air_metallib lib;
+   const char *err;
+   if (size >= 4 && !memcmp(buf, "MTLB", 4)) {
+      if (!air_metallib_parse(NULL, buf, size, &lib, &err))
+         errx(1, "%s: %s", filename, err);
+      unsigned pick = lib.num_functions;
+      for (unsigned i = 0; i < lib.num_functions; i++) {
+         if (!entry || !strcmp(entry, lib.functions[i].name)) {
+            pick = i;
+            break;
+         }
+      }
+      if (pick == lib.num_functions)
+         errx(1, "%s: no function %s", filename, entry ? entry : "(any)");
+      bitcode = lib.functions[pick].bitcode;
+      bitcode_size = lib.functions[pick].bitcode_size;
+      entry = lib.functions[pick].name;
+   }
+
+   struct air_constant_value *fc;
+   unsigned num_fc = air_module_function_constants(NULL, bitcode, bitcode_size, &fc);
+   /* An air.visible library function is not an entry point; the wrapper makes
+    * one that calls it, so that these 135 modules can be compiled for the
+    * Adreno at all (nir_air.h, docs/air.md section 5). Always on here: this
+    * tool exists to answer "does ir3 accept it", and a module that is not an
+    * entry point has no other way to be asked.
+    */
+   const struct air_to_nir_options options = {
+      .constants = fc,
+      .num_constants = num_fc,
+      .library_wrapper = true,
+   };
+   struct air_shader_info info;
+   nir_shader *nir = air_to_nir(NULL, bitcode, bitcode_size, NULL, &options,
+                                ir3_get_compiler_options(compiler), &info, &err);
+   if (!nir)
+      errx(1, "%s: %s", entry ? entry : filename, err);
+
+   printf("; AIR: %s, %u resources, %u varyings, %u render targets\n",
+          info.entry_point, info.num_resources, info.num_varyings,
+          info.num_render_targets);
+   nir_print_shader(nir, stdout);
+   return nir;
+}
