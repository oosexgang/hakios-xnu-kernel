+   {
+      struct fd_context *ctx = fd_context(pctx);
+      static int wanted = -1;
+
+      if (wanted < 0)
+         wanted = debug_get_num_option("FD_FBFETCH_FLUSH", 1);
+      if (wanted && ctx->screen->gen >= 7 && ctx->prog.fs && ctx->batch &&
+          ctx->batch->num_draws != 0 &&
+          ir3_get_shader_info((struct ir3_shader_state *)ctx->prog.fs)->fs.uses_fbfetch_output)
+         pctx->flush(pctx, NULL, 0);
+   }
+
    fd_draw_vbo(pctx, info, drawid_offset, indirect, draws, num_draws);
 
