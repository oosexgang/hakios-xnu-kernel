+// (hakios) Turnip there imports a host pointer only as an IOSurface's memory, which its kernel makes a buffer of by the surface's ID:
+// the surface mapped at base is told to it (tools/mesa/hakios-drm: hakios_drm_host_surface) before the runtime imports the pages.
+static void tellHostSurface(IOSurfaceRef surface,void *base,size_t bytes) {
+ static void (*tell)(const void *,uint64_t,uint32_t);
+ static std::once_flag once;
+ std::call_once(once,[]{
+  if(void *turnip=gLoaderPath.empty()?nullptr:dlopen(gLoaderPath.c_str(),RTLD_NOW|RTLD_NOLOAD))
+   tell=(void (*)(const void *,uint64_t,uint32_t))dlsym(turnip,"hakios_drm_host_surface");
+ });
+ if(tell)tell(base,bytes,IOSurfaceGetID(surface));
+}
 static NBBuffer *surfaceBuffer(IOSurfaceRef surface,void *base,size_t bytes) {
