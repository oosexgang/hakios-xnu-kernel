 /// The refusal of host memory this device cannot import exactly.
+#[track_caller]
 pub(super) fn not_importable() -> Error {
+    // (hakios) where it was refused, once per site: the refusal itself names no reason
+    {
+        use std::sync::Mutex;
+        static SAID: Mutex<Vec<String>> = Mutex::new(Vec::new());
+        let at = std::panic::Location::caller().to_string();
+        if let Ok(mut said) = SAID.lock() {
+            if !said.contains(&at) && said.len() < 32 {
+                eprintln!("metal2vulkan: host memory refused at {at} (error)");
+                said.push(at);
+            }
+        }
+    }
     Error::Unsupported(Unsupported::not_representable(Feature::HostMemory))
 }
 
