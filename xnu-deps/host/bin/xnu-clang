#!/bin/bash
# clang wrapper for cross-building XNU on Linux:
#  - forces an Apple Mach-O target (stock Linux clang defaults to ELF)
#  - drops flags only Apple's clang understands
#  - links with the cctools ld64
HB="$(cd "$(dirname "$0")" && pwd)"
case "$(basename "$0")" in *++) drv=clang++; extra=(-fno-use-cxa-atexit);; *) drv=clang; extra=();; esac
args=()
for a in "$@"; do
  case "$a" in
    -enable-trivial-auto-var-init-zero-knowing-it-will-be-removed-from-clang) ;;
    -fapple-kext-vtable-verify|-Wno-vla-cxx-extension) ;;
    -Werror|-Werror=*|-Weverything|-pedantic-errors) ;;
    *) args+=("$a");;
  esac
done
# The driver: /usr/bin/<drv> when the machine has it there (the usual case), otherwise the one on the
# PATH (a machine that installs clang without root, for instance). HAKIOS_CLANG names it outright.
CLANG_BIN=${HAKIOS_CLANG:-}
if [ -z "$CLANG_BIN" ]; then
  if [ -x "/usr/bin/$drv" ]; then CLANG_BIN="/usr/bin/$drv"; else CLANG_BIN=$(command -v "$drv"); fi
fi
[ -n "$CLANG_BIN" ] || { echo "xnu-clang: no $drv found" >&2; exit 1; }
exec "$CLANG_BIN" -include "$HB/../../hostinc/xnu_clang_compat.h" -target arm64-apple-ios${XNU_SDK_VERSION:-16.5} --ld-path="$HB/ld64" \
  -w "${extra[@]}" "${args[@]}"
