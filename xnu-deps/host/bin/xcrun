#!/bin/bash
# Minimal xcrun replacement for building XNU on Linux
HB="$(cd "$(dirname "$0")" && pwd)"
sdk=""; find=""; show=""
while [ $# -gt 0 ]; do case "$1" in
  -sdk) sdk="$2"; shift 2;; -verbose) shift;;
  -find|--find|-f) find="$2"; shift 2;;
  -show-sdk-path|--show-sdk-path) show=path; shift;;
  -show-sdk-version|--show-sdk-version) show=version; shift;;
  -show-sdk-platform-path|--show-sdk-platform-path) show=platform; shift;;
  -show-sdk-platform-version) show=version; shift;;
  *) break;; esac; done
case "$show$sdk" in
  pathmacosx*) [ "$(uname -s)" = Darwin ] && exec /usr/bin/xcrun --show-sdk-path;;
esac
SDKP="${XNU_SDK_PATH:?XNU_SDK_PATH not set}"
case "$show" in
  # The build asks for two SDKs: the kernel's (iphoneos, ours) and this machine's own for the
  # tools it compiles to run here (-sdk macosx). On Linux there is no second one and everything
  # is ours; on macOS the real xcrun knows where it is.
  path) case "$sdk" in
      /*) echo "$sdk";;
      macosx*) [ "$(uname -s)" = Darwin ] && /usr/bin/xcrun --show-sdk-path || echo "$SDKP";;
      *) echo "$SDKP";;
    esac; exit 0;;
  version) echo "${XNU_SDK_VERSION:-16.5}"; exit 0;;
  platform) echo "${XNU_PLATFORM_PATH:-/Platforms/iPhoneOS.platform}"; exit 0;;
esac
if [ -n "$find" ]; then
  for d in "$HB" /usr/bin; do [ -x "$d/$find" ] && { echo "$d/$find"; exit 0; }; done
  exit 1
fi
[ $# -gt 0 ] && exec "$@"
