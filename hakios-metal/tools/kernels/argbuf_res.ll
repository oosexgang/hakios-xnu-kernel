; argbuf_res, the AIR side: a kernel whose every resource is a member of one
; argument buffer at [[buffer(0)]] -- the output buffer, a sampler and two
; textures -- generated by workspace-air's tools/air/argbufcheck.py (its
; argbuf_resources case: build(), chain()) and kept as it came out:
;     out[tid] = (uint(t0.sample(s, 1.5).x) << 16) + uint(t1.read(uint2(1, 1)).x)
; Hand-written by that script, ours, MIT: only the SHAPE of the metadata is
; Apple's convention.
; Why it exists: the runtime reads each member's eight bytes out of the set (a
; buffer's GPU address, a texture's or sampler's resource id) and binds it at
; the index the front end allocated; with t0 all 7 and t1 all 1000 the word is
; 7 << 16 | 1000, and two textures swapped, or a member not bound, give another.
source_filename = "argbuf_res"
target datalayout = "e-p:64:64:64-i1:8:8-i8:8:8-i16:16:16-i32:32:32-i64:64:64-f32:32:32-f64:64:64-v16:16:16-v24:32:32-v32:32:32-v48:64:64-v64:64:64-v96:128:128-v128:128:128-v192:256:256-v256:256:256-v512:512:512-v1024:1024:1024-n8:16:32"
target triple = "air64-apple-ios14.0.0"

%"struct.metal::sampler" = type { ptr addrspace(2) }
%"struct.metal::texture2d" = type { ptr addrspace(1) }
%struct.spvDescriptorSetBuffer0 = type { ptr addrspace(1), %"struct.metal::sampler", %"struct.metal::texture2d", %"struct.metal::texture2d" }
declare { <4 x float>, i8 } @air.sample_texture_2d.v4f32(ptr addrspace(1), ptr addrspace(2), <2 x float>, i1, <2 x i32>, i1, float, float, i32) local_unnamed_addr
declare { <4 x float>, i8 } @air.read_texture_2d.v4f32(ptr addrspace(1), <2 x i32>, i32, i32) local_unnamed_addr

define void @argbuf_res(ptr addrspace(2) %0, i32 %1) local_unnamed_addr {
  %outa = getelementptr inbounds %struct.spvDescriptorSetBuffer0, ptr addrspace(2) %0, i64 0, i32 0
  %out = load ptr addrspace(1), ptr addrspace(2) %outa, align 8
  %sampa = getelementptr inbounds %struct.spvDescriptorSetBuffer0, ptr addrspace(2) %0, i64 0, i32 1, i32 0
  %samp = load ptr addrspace(2), ptr addrspace(2) %sampa, align 8
  %t0a = getelementptr inbounds %struct.spvDescriptorSetBuffer0, ptr addrspace(2) %0, i64 0, i32 2
  %t0b = getelementptr inbounds %"struct.metal::texture2d", ptr addrspace(2) %t0a, i64 0, i32 0
  %t0 = load ptr addrspace(1), ptr addrspace(2) %t0b, align 8
  %t1a = getelementptr inbounds %struct.spvDescriptorSetBuffer0, ptr addrspace(2) %0, i64 0, i32 3
  %t1b = getelementptr inbounds %"struct.metal::texture2d", ptr addrspace(2) %t1a, i64 0, i32 0
  %t1 = load ptr addrspace(1), ptr addrspace(2) %t1b, align 8
  %sr = tail call { <4 x float>, i8 } @air.sample_texture_2d.v4f32(ptr addrspace(1) %t0, ptr addrspace(2) %samp, <2 x float> <float 1.500000000e+00, float 1.500000000e+00>, i1 true, <2 x i32> zeroinitializer, i1 false, float 0.0, float 0.0, i32 0)
  %sv = extractvalue { <4 x float>, i8 } %sr, 0
  %s0 = extractelement <4 x float> %sv, i64 0
  %rr = tail call { <4 x float>, i8 } @air.read_texture_2d.v4f32(ptr addrspace(1) %t1, <2 x i32> <i32 1, i32 1>, i32 0, i32 0)
  %rv = extractvalue { <4 x float>, i8 } %rr, 0
  %r0 = extractelement <4 x float> %rv, i64 0
  %si = fptoui float %s0 to i32
  %ri = fptoui float %r0 to i32
  %hi = shl i32 %si, 16
  %r = add i32 %hi, %ri
  %oi = zext i32 %1 to i64
  %op = getelementptr inbounds i32, ptr addrspace(1) %out, i64 %oi
  store i32 %r, ptr addrspace(1) %op, align 4

  ret void
}

!llvm.module.flags = !{!0}
!air.version = !{!1}
!air.language_version = !{!2}
!air.kernel = !{!3}

!0 = !{i32 1, !"wchar_size", i32 4}
!1 = !{i32 2, i32 3, i32 0}
!2 = !{!"Metal", i32 2, i32 3, i32 0}
!3 = !{ptr @argbuf_res, !4, !5}
!4 = !{}
!5 = !{!6, !100}
!6 = !{i32 0, !"air.indirect_buffer", !"air.buffer_size", i32 32, !"air.location_index", i32 0, i32 1, !"air.read", !"air.struct_type_info", !7, !"air.arg_type_size", i32 32, !"air.arg_type_align_size", i32 8, !"air.arg_type_name", !"spvDescriptorSetBuffer0", !"air.arg_name", !"spvDescriptorSet0"}
!7 = !{i32 0, i32 8, i32 0, !"ty_devrw_0", !"devrw0", !"air.indirect_argument", !10, i32 8, i32 8, i32 0, !"ty_sampler_1", !"sampler1", !"air.indirect_argument", !11, i32 16, i32 8, i32 0, !"ty_texture_2", !"texture2", !"air.indirect_argument", !12, i32 24, i32 8, i32 0, !"ty_texture_3", !"texture3", !"air.indirect_argument", !13}
!10 = !{i32 0, !"air.buffer", !"air.location_index", i32 0, i32 1, !"air.read_write", !"air.arg_type_size", i32 4, !"air.arg_type_align_size", i32 4, !"air.arg_type_name", !"ty_devrw_0", !"air.arg_name", !"devrw0"}
!11 = !{i32 1, !"air.sampler", !"air.location_index", i32 1, i32 1, !"air.arg_type_size", i32 4, !"air.arg_type_align_size", i32 4, !"air.arg_type_name", !"ty_sampler_1", !"air.arg_name", !"sampler1"}
!12 = !{i32 2, !"air.texture", !"air.location_index", i32 2, i32 1, !"air.sample", !"air.arg_type_size", i32 4, !"air.arg_type_align_size", i32 4, !"air.arg_type_name", !"ty_texture_2", !"air.arg_name", !"texture2"}
!13 = !{i32 3, !"air.texture", !"air.location_index", i32 3, i32 1, !"air.sample", !"air.arg_type_size", i32 4, !"air.arg_type_align_size", i32 4, !"air.arg_type_name", !"ty_texture_3", !"air.arg_name", !"texture3"}
!100 = !{i32 1, !"air.thread_index_in_threadgroup", !"air.arg_type_name", !"uint", !"air.arg_name", !"tid"}
