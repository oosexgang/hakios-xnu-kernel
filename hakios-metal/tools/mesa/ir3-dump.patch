+static void
+dump_fixture(struct ir3_shader_variant *v, uint32_t *bin, const char *path,
+             const char *in_path, const char *source_path,
+             const char *kernel_name, const struct fd_dev_id *dev_id,
+             const struct fixture_textures *tex,
+             const struct fixture_output_classes *output_classes)
+{
+   const struct ir3_const_state *cs = ir3_const_state(v);
+   const struct fd_dev_info *dev_info = fd_dev_info_raw(dev_id);
+   const unsigned max_ubo_ranges = 32;  /* kernel.hpp's kMaxUboRanges */
+
+   /* What the fixture is: a Kernel for a compute variant, a Stage (render.hpp:
+    * a Kernel plus what the 3D registers read) for a vertex or fragment one.
+    * The other stages have no struct here: refused by name, not written as a
+    * compute-shaped Kernel, which is what this did for a VS until 29 October.
+    */
+   bool stage_fixture;
+   switch (v->type) {
+   case MESA_SHADER_COMPUTE:
+   case MESA_SHADER_KERNEL:
+      stage_fixture = false;
+      break;
+   case MESA_SHADER_VERTEX:
+   case MESA_SHADER_FRAGMENT:
+      stage_fixture = true;
+      break;
+   default:
+      errx(1, "-o: a %s shader: the fixtures hold a compute Kernel or a vertex/fragment Stage, nothing else",
+           gl_shader_stage_name(v->type));
+   }
+
+   /* The kernel's name: -n, else the entry point's (nir->info.name); made an identifier. */
+   char name[128];
+   const char *nir_name = kernel_name ? kernel_name : "kernel";
+   unsigned n = 0;
+   for (const char *c = nir_name; *c && n + 1 < sizeof(name); c++)
+      name[n++] = isalnum((unsigned char)*c) ? *c : '_';
+   name[n] = 0;
+   if (!n || isdigit((unsigned char)name[0]))
+      errx(1, "-o: cannot name the kernel after \"%s\"", nir_name);
+
+   /* The kernel text, when given (-s): the .ll of an AIR kernel, for the record. */
+   void *source = NULL;
+   size_t source_size = 0;
+   if (source_path && read_file(source_path, &source, &source_size))
+      errx(1, "-s %s: cannot read it", source_path);
+
+   if (cs->ubo_state.num_enabled > max_ubo_ranges)
+      errx(1, "-o: %u UBO ranges, the Kernel struct holds %u",
+           cs->ubo_state.num_enabled, max_ubo_ranges);
+
+   char *listing = NULL;
+   size_t listing_size = 0;
+   FILE *ls = open_memstream(&listing, &listing_size);
+   ir3_shader_disasm(v, bin, ls);
+   fclose(ls);
+
+   FILE *out = fopen(path, "w");
+   if (!out)
+      errx(1, "%s: cannot write it", path);
+
+   uint32_t num_words = v->info.size / 4;
+
+   fprintf(out,
+           "// %s: hakios::metal::%s fixture, generated by ir3_compiler -o (tools/mesa/ir3-dump.patch)\n"
+           "// from %s for %s (chip id 0x%" PRIx64 ", gen %u). Do not edit; recompile the %s.\n"
+           "// SPDX-License-Identifier: MIT\n"
+           "#pragma once\n\n"
+           "#include \"hakios-metal/%s.hpp\"\n\n"
+           "namespace hakios::metal::kernels {\n\n",
+           name, stage_fixture ? "Stage" : "Kernel", in_path, fd_dev_name(dev_id), dev_id->chip_id,
+           dev_info->chip, stage_fixture ? "shader" : "kernel", stage_fixture ? "render" : "kernel");
+
+   char words_name[160], imm_name[160];
+   snprintf(words_name, sizeof(words_name), "%s_words", name);
+   snprintf(imm_name, sizeof(imm_name), "%s_immediates", name);
+   emit_words(out, words_name, bin, num_words);
+   fputc('\n', out);
+   if (cs->immediates_count) {
+      emit_words(out, imm_name, cs->immediates, cs->immediates_count);
+      fputc('\n', out);
+   }
+
+   if (!stage_fixture) {
+      fprintf(out, "constexpr Kernel %s = {\n", name);
+      emit_kernel_fields(out, "    ", v, name, num_words, words_name, imm_name, source, source_size, tex);
+   } else {
+      fprintf(out, "constexpr Stage %s = {\n", name);
+      fputs("    /* .k = */ {\n", out);
+      emit_kernel_fields(out, "        ", v, name, num_words, words_name, imm_name, source, source_size, tex);
+      fputs("    },\n", out);
+      emit_stage_fields(out, v, output_classes);
+   }
+   fputs("};\n\n", out);
+
+   fputs("// The listing (ir3_shader_disasm):\n", out);
+   emit_comment_block(out, listing);
+   fputs("\n} // namespace hakios::metal::kernels\n", out);
+   fclose(out);
+   free(listing);
+   printf("wrote %s\n", path);
+}
