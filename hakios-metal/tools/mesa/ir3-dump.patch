+/* -o FILE: the compiled variant written out as a hakios::metal::Kernel fixture,
+ * in the format hakios-metal's tools/ir3-kernel writes for a text kernel (its
+ * include/hakios-metal/kernel.hpp documents every field and the register that
+ * reads it): constexpr arrays of the words and the immediates, a constexpr
+ * Kernel with every field in order, and the listing as comments. The two
+ * writers are kept in step by hand; a field added to the struct is added to
+ * both. It lives here because this is the only place where an AIR kernel's
+ * variant exists: ir3_compiler has no binary output of its own, and the driver
+ * needs the words together with the layout ir3 chose for them -- where the
+ * driver params and the pushed UBO ranges go -- which no listing carries whole.
+ */
+static void
+emit_words(FILE *out, const char *name, const uint32_t *words, uint32_t count)
+{
+   fprintf(out, "constexpr uint32_t %s[] = {", name);
+   for (uint32_t i = 0; i < count; i++) {
+      if (i % 4 == 0)
+         fputs("\n   ", out);
+      fprintf(out, " 0x%08x,", words[i]);
+   }
+   fputs("\n};\n", out);
+}
+
+static void
+emit_comment_block(FILE *out, const char *text)
+{
+   while (*text) {
+      const char *nl = strchr(text, '\n');
+      size_t len = nl ? (size_t)(nl - text) : strlen(text);
+      fprintf(out, "// %.*s\n", (int)len, text);
+      text += len + (nl ? 1 : 0);
+   }
+}
+
+/* -o: the kernel's textures, images and samplers as its INSTRUCTIONS address
+ * them (kernel.hpp: Kernel::textures, numTextureSlots, samplerMask), read off
+ * the NIR the front end produced, before ir3 lowers it. ir3's own num_samp
+ * counts sampled textures and images together and never looks at a sampler
+ * index (ir3_compiler_nir.c: num_samp = last texture used + 1 + num_images),
+ * so the dispatch cannot size its tables from it; and the front end's resource
+ * list says what was declared, not what the code does with it. The walk is the
+ * one hakios-metal's compileAir makes in-process (src/compiler.cpp), so that a
+ * fixture and an in-process compile agree field for field (compiler_test):
+ *
+ *   nir_tex_instr          slot texture_index, kind sampled (1): sam/saml with
+ *                          a sampler, isaml for texture.read (txf). dim from
+ *                          sampler_dim, element from dest_type -- but not from
+ *                          a query (txs, lod, query_levels...), whose int
+ *                          result is not the texture's class. The ops that take
+ *                          a sampler (tex, txb, txl, txd, tg4, lod:
+ *                          nir_tex_instr_need_sampler) set the sampler's bit;
+ *                          txf, txf_ms and the queries do not.
+ *   image_load/store       slot src[0] (always an immediate from the front end),
+ *                          kind image (2): ldib/stib at IBO slot num_ssbos +
+ *                          index (ir3_image.c:50-52). element from dest_type /
+ *                          src_type and the WIDTH from the value's bit size, as
+ *                          ir3_get_type_for_image_intrinsic reads them
+ *                          (ir3_image.c:96-141): a half image is a 16-bit stib
+ *                          into whatever descriptor is bound.
+ *   image_atomic(_swap)    the same, read and written, the atomic op's type.
+ *   image_size/levels/samples   the slot's kind and dimension only.
+ *
+ * A texture or sampler chosen at run time, an index at or past the Kernel's
+ * sixteen slots, a dimension or element class the Kernel has no name for, or
+ * one index used two ways are refused by name: the Kernel has no field for them.
+ */
+#define FIXTURE_TEXTURE_SLOTS 16   /* kernel.hpp's kMaxTextureSlots */
+
+struct fixture_texture {
+   uint8_t kind, dim, is_array, element, bits, read, write;   /* KernelTexture, less its pad */
+};
+
+struct fixture_textures {
+   struct fixture_texture slot[FIXTURE_TEXTURE_SLOTS];
+   unsigned num_slots;      /* highest SAMPLED index + 1: Kernel::numTextureSlots */
+   uint32_t sampler_mask;   /* Kernel::samplerMask */
+};
+
+static uint8_t
+fixture_dim(enum glsl_sampler_dim dim, const char *what, unsigned index)
+{
+   switch (dim) {
+   case GLSL_SAMPLER_DIM_1D:   return 1;   /* kTexDim1D */
+   case GLSL_SAMPLER_DIM_2D:
+   case GLSL_SAMPLER_DIM_RECT: return 2;   /* kTexDim2D */
+   case GLSL_SAMPLER_DIM_3D:   return 3;   /* kTexDim3D */
+   case GLSL_SAMPLER_DIM_CUBE: return 4;   /* kTexDimCube */
+   default:
+      errx(1, "-o: %s %u has a dimension (glsl_sampler_dim %d) KernelTextureDim has no name for",
+           what, index, (int)dim);
+   }
+}
+
+static uint8_t
+fixture_element(nir_alu_type type, const char *what, unsigned index)
+{
+   switch (nir_alu_type_get_base_type(type)) {
+   case nir_type_float: return 0;   /* kElemFloat */
+   case nir_type_uint:  return 1;   /* kElemUint */
+   case nir_type_int:   return 2;   /* kElemInt */
+   default:
+      errx(1, "-o: %s %u moves values of nir_alu_type %d, which is not float, uint or int",
+           what, index, (int)type);
+   }
+}
+
+static struct fixture_texture *
+fixture_slot(struct fixture_textures *t, unsigned index, uint8_t kind, const char *what)
+{
+   if (index >= FIXTURE_TEXTURE_SLOTS)
+      errx(1, "-o: %s index %u: the Kernel holds %u texture slots", what, index,
+           FIXTURE_TEXTURE_SLOTS);
+   struct fixture_texture *s = &t->slot[index];
+   if (s->kind && s->kind != kind)
+      errx(1, "-o: texture index %u is both sampled and addressed as an image", index);
+   s->kind = kind;
+   return s;
+}
+
+static void
+walk_textures(nir_shader *nir, struct fixture_textures *t)
+{
+   memset(t, 0, sizeof(*t));
+   nir_foreach_function_impl(impl, nir) {
+      nir_foreach_block(block, impl) {
+         nir_foreach_instr(instr, block) {
+            if (instr->type == nir_instr_type_tex) {
+               nir_tex_instr *tex = nir_instr_as_tex(instr);
+               if (nir_tex_instr_src_index(tex, nir_tex_src_texture_offset) >= 0 ||
+                   nir_tex_instr_src_index(tex, nir_tex_src_sampler_offset) >= 0 ||
+                   nir_tex_instr_src_index(tex, nir_tex_src_texture_handle) >= 0 ||
+                   nir_tex_instr_src_index(tex, nir_tex_src_sampler_handle) >= 0)
+                  errx(1, "-o: a texture or sampler chosen at run time: the Kernel addresses them by Metal's own indices only");
+               struct fixture_texture *s = fixture_slot(t, tex->texture_index, 1, "texture");
+               s->dim = fixture_dim(tex->sampler_dim, "texture", tex->texture_index);
+               s->is_array = tex->is_array;
+               s->read = 1;
+               if (!nir_tex_instr_is_query(tex))
+                  s->element = fixture_element(tex->dest_type, "texture", tex->texture_index);
+               if (nir_tex_instr_need_sampler(tex)) {
+                  if (tex->sampler_index >= FIXTURE_TEXTURE_SLOTS)
+                     errx(1, "-o: sampler index %u: the Kernel holds %u sampler slots",
+                          tex->sampler_index, FIXTURE_TEXTURE_SLOTS);
+                  t->sampler_mask |= 1u << tex->sampler_index;
+               }
+               if (tex->texture_index + 1 > t->num_slots)
+                  t->num_slots = tex->texture_index + 1;
+            } else if (instr->type == nir_instr_type_intrinsic) {
+               nir_intrinsic_instr *in = nir_instr_as_intrinsic(instr);
+               nir_alu_type type = nir_type_invalid;
+               bool read = false, write = false, typed = true;
+               switch (in->intrinsic) {
+               case nir_intrinsic_image_load:
+                  type = nir_intrinsic_dest_type(in);
+                  read = true;
+                  break;
+               case nir_intrinsic_image_store:
+                  type = nir_intrinsic_src_type(in);
+                  write = true;
+                  break;
+               case nir_intrinsic_image_atomic:
+               case nir_intrinsic_image_atomic_swap:
+                  type = nir_atomic_op_type(nir_intrinsic_atomic_op(in));
+                  read = write = true;
+                  break;
+               case nir_intrinsic_image_size:
+               case nir_intrinsic_image_levels:
+               case nir_intrinsic_image_samples:
+                  typed = false;
+                  break;
+               default:
+                  continue;
+               }
+               if (!nir_src_is_const(in->src[0]))
+                  errx(1, "-o: an image chosen at run time: the Kernel addresses images by Metal's own indices only");
+               unsigned index = nir_src_as_uint(in->src[0]);
+               struct fixture_texture *s = fixture_slot(t, index, 2, "image");
+               s->dim = fixture_dim(nir_intrinsic_image_dim(in), "image", index);
+               s->is_array = nir_intrinsic_image_array(in);
+               s->read |= read;
+               s->write |= write;
+               if (typed) {
+                  const nir_intrinsic_info *info = &nir_intrinsic_infos[in->intrinsic];
+                  unsigned bits = info->has_dest ? in->def.bit_size : nir_src_bit_size(in->src[3]);
+                  uint8_t element = fixture_element(type, "image", index);
+                  if (s->bits && (s->bits != bits || s->element != element))
+                     errx(1, "-o: image %u is addressed as %u-bit values of element class %u and as %u-bit values of class %u",
+                          index, s->bits, s->element, bits, element);
+                  s->element = element;
+                  s->bits = bits;
+               }
+            }
+         }
+      }
+   }
+}
+
+static int read_file(const char *filename, void **ptr, size_t *size);
+
+static void
+dump_fixture(struct ir3_shader_variant *v, uint32_t *bin, const char *path,
+             const char *in_path, const char *source_path,
+             const char *kernel_name, const struct fd_dev_id *dev_id,
+             const struct fixture_textures *tex)
+{
+   const struct ir3_const_state *cs = ir3_const_state(v);
+   const struct fd_dev_info *dev_info = fd_dev_info_raw(dev_id);
+   const unsigned max_ubo_ranges = 8;   /* kernel.hpp's kMaxUboRanges */
+   const unsigned max_bufs = 4;         /* kMaxBufs */
+   const unsigned no_const_regid = 0xff;
+
+   /* The kernel's name: -n, else the entry point's (nir->info.name); made an identifier. */
+   char name[128];
+   const char *nir_name = kernel_name ? kernel_name : "kernel";
+   unsigned n = 0;
+   for (const char *c = nir_name; *c && n + 1 < sizeof(name); c++)
+      name[n++] = isalnum((unsigned char)*c) ? *c : '_';
+   name[n] = 0;
+   if (!n || isdigit((unsigned char)name[0]))
+      errx(1, "-o: cannot name the kernel after \"%s\"", nir_name);
+
+   /* The kernel text, when given (-s): the .ll of an AIR kernel, for the record. */
+   void *source = NULL;
+   size_t source_size = 0;
+   if (source_path && read_file(source_path, &source, &source_size))
+      errx(1, "-s %s: cannot read it", source_path);
+
+   if (cs->ubo_state.num_enabled > max_ubo_ranges)
+      errx(1, "-o: %u UBO ranges, the Kernel struct holds %u",
+           cs->ubo_state.num_enabled, max_ubo_ranges);
+
+   char *listing = NULL;
+   size_t listing_size = 0;
+   FILE *ls = open_memstream(&listing, &listing_size);
+   ir3_shader_disasm(v, bin, ls);
+   fclose(ls);
+
+   FILE *out = fopen(path, "w");
+   if (!out)
+      errx(1, "%s: cannot write it", path);
+
+   uint32_t num_words = v->info.size / 4;
+   uint32_t local_id = ir3_find_sysval_regid(v, SYSTEM_VALUE_LOCAL_INVOCATION_ID);
+   uint32_t wg_id = ir3_find_sysval_regid(v, SYSTEM_VALUE_WORKGROUP_ID);
+   int32_t driver_params =
+      ir3_const_can_upload(&cs->allocs, IR3_CONST_ALLOC_DRIVER_PARAMS, v->constlen)
+         ? (int32_t)cs->allocs.consts[IR3_CONST_ALLOC_DRIVER_PARAMS].offset_vec4
+         : -1;
+
+   fprintf(out,
+           "// %s: hakios::metal::Kernel fixture, generated by ir3_compiler -o (tools/mesa/ir3-dump.patch)\n"
+           "// from %s for %s (chip id 0x%" PRIx64 ", gen %u). Do not edit; recompile the kernel.\n"
+           "// SPDX-License-Identifier: MIT\n"
+           "#pragma once\n\n"
+           "#include \"hakios-metal/kernel.hpp\"\n\n"
+           "namespace hakios::metal::kernels {\n\n",
+           name, in_path, fd_dev_name(dev_id), dev_id->chip_id, dev_info->chip);
+
+   char words_name[160], imm_name[160];
+   snprintf(words_name, sizeof(words_name), "%s_words", name);
+   snprintf(imm_name, sizeof(imm_name), "%s_immediates", name);
+   emit_words(out, words_name, bin, num_words);
+   fputc('\n', out);
+   if (cs->immediates_count) {
+      emit_words(out, imm_name, cs->immediates, cs->immediates_count);
+      fputc('\n', out);
+   }
+
+   fprintf(out, "constexpr Kernel %s = {\n", name);
+   fprintf(out, "    /* .words = */ %s,\n", words_name);
+   fprintf(out, "    /* .numWords = */ %u,\n", num_words);
+   fprintf(out, "    /* .instrlen = */ %u,\n", v->instrlen);
+   fprintf(out, "    /* .constlen = */ %u,\n", v->constlen);
+   fprintf(out, "    /* .maxReg = */ %d,\n", v->info.max_reg);
+   fprintf(out, "    /* .maxHalfReg = */ %d,\n", v->info.max_half_reg);
+   fprintf(out, "    /* .doubleThreadsize = */ %s,\n", v->info.double_threadsize ? "true" : "false");
+   fprintf(out, "    /* .mergedRegs = */ %s,\n", v->mergedregs ? "true" : "false");
+   fprintf(out, "    /* .earlyPreamble = */ %s,\n", v->early_preamble ? "true" : "false");
+   fprintf(out, "    /* .branchstackHw = */ %u,\n", ir3_shader_branchstack_hw(v));
+   fprintf(out, "    /* .sharedSize = */ %u,\n", v->shared_size);
+   fprintf(out, "    /* .pvtmemSize = */ %u,\n", v->pvtmem_size);
+   fprintf(out, "    /* .pvtmemPerWave = */ %s,\n", v->pvtmem_per_wave ? "true" : "false");
+   fprintf(out, "    /* .localSize = */ {%u, %u, %u},\n", v->local_size[0], v->local_size[1],
+           v->local_size[2]);
+   fprintf(out, "    /* .localSizeVariable = */ %s,\n", v->local_size_variable ? "true" : "false");
+   fprintf(out, "    /* .localIdRegid = */ 0x%02x,\n", local_id);
+   fprintf(out, "    /* .workGroupIdRegid = */ 0x%02x,\n", wg_id);
+   fprintf(out, "    /* .immediates = */ %s,\n", cs->immediates_count ? imm_name : "nullptr");
+   fprintf(out, "    /* .numImmediates = */ %u,\n", cs->immediates_count);
+   fprintf(out, "    /* .immediatesOffsetVec4 = */ %u,\n", cs->allocs.max_const_offset_vec4);
+   fprintf(out, "    /* .driverParamsOffsetVec4 = */ %d,\n", driver_params);
+   fprintf(out, "    /* .numUbos = */ %u,\n", cs->num_ubos);
+   fprintf(out, "    /* .numSsbos = */ %u,\n", v->num_ssbos);
+   fprintf(out, "    /* .numIbos = */ %u,\n", v->num_ibos);
+   fprintf(out, "    /* .numSamp = */ %d,\n", v->num_samp);
+   fputs("    /* .uboRanges = */ {", out);
+   for (unsigned i = 0; i < max_ubo_ranges; i++) {
+      if (i < cs->ubo_state.num_enabled) {
+         const struct ir3_ubo_range *r = &cs->ubo_state.range[i];
+         fprintf(out, "%s{%u, %u, %u, %u}", i ? ", " : "", r->ubo.block, r->offset / 16,
+                 r->start / 4, (r->end - r->start) / 4);
+      } else {
+         fprintf(out, "%s{0, 0, 0, 0}", i ? ", " : "");
+      }
+   }
+   fputs("},\n", out);
+   fprintf(out, "    /* .numUboRanges = */ %u,\n", cs->ubo_state.num_enabled);
+   /* @buf and @numwg are the text assembler's; a compiled kernel binds its
+    * buffers as SSBOs/UBOs and reads its grid from the driver params.
+    */
+   fputs("    /* .numBufs = */ 0,\n", out);
+   fputs("    /* .bufs = */ {", out);
+   for (unsigned i = 0; i < max_bufs; i++)
+      fprintf(out, "%s{0, 0x%02x}", i ? ", " : "", no_const_regid);
+   fputs("},\n", out);
+   fprintf(out, "    /* .numwgConstRegid = */ 0x%02x,\n", no_const_regid);
+   fprintf(out, "    /* .constantDataOffset = */ %u,\n", v->info.constant_data_offset);
+   fprintf(out, "    /* .constantDataSize = */ %u,\n", v->constant_data_size);
+   fprintf(out, "    /* .name = */ \"%s\",\n", name);
+   fprintf(out, "    /* .source = */ R\"ir3(%.*s)ir3\",\n", (int)source_size,
+           source ? (const char *)source : "");
+   /* The texture slots: `{}` when the kernel addresses none (the text kernels'
+    * form, tools/ir3-kernel.cc), else every slot up to the highest addressed,
+    * all eight members of each (the pad too) so that -Wextra sees them
+    * initialized, with what each is in words beside it.
+    */
+   unsigned last_slot = 0;
+   bool any_slot = false;
+   for (unsigned i = 0; i < FIXTURE_TEXTURE_SLOTS; i++) {
+      if (tex->slot[i].kind) {
+         any_slot = true;
+         last_slot = i;
+      }
+   }
+   if (!any_slot) {
+      fputs("    /* .textures = */ {},\n", out);
+   } else {
+      static const char *const dims[] = { "?", "1D", "2D", "3D", "cube" };
+      static const char *const elements[] = { "float", "uint", "int" };
+      fputs("    /* .textures = */ {\n", out);
+      for (unsigned i = 0; i <= last_slot; i++) {
+         const struct fixture_texture *s = &tex->slot[i];
+         fprintf(out, "        /* [%u] */ {%u, %u, %u, %u, %u, %u, %u, 0},", i, s->kind, s->dim,
+                 s->is_array, s->element, s->bits, s->read, s->write);
+         if (!s->kind)
+            fputs("   // not addressed\n", out);
+         else
+            fprintf(out, "   // %s %s%s of %s%s%s%s\n", s->kind == 1 ? "sampled" : "image",
+                    dims[s->dim], s->is_array ? " array" : "", elements[s->element],
+                    s->bits == 16 ? " as 16-bit" : s->bits ? " as 32-bit" : "",
+                    s->read ? ", read" : "", s->write ? ", written" : "");
+      }
+      fputs("    },\n", out);
+   }
+   fprintf(out, "    /* .numTextureSlots = */ %u,\n", tex->num_slots);
+   if (tex->sampler_mask)
+      fprintf(out, "    /* .samplerMask = */ 0x%x,\n", tex->sampler_mask);
+   else
+      fputs("    /* .samplerMask = */ 0,\n", out);
+   fputs("};\n\n", out);
+
+   fputs("// The listing (ir3_shader_disasm):\n", out);
+   emit_comment_block(out, listing);
+   fputs("\n} // namespace hakios::metal::kernels\n", out);
+   fclose(out);
+   free(listing);
+   printf("wrote %s\n", path);
+}
