diff --git a/bsd/kern/kern_sysctl.c b/bsd/kern/kern_sysctl.c
index 94a949b..a4ebb2c 100644
--- a/bsd/kern/kern_sysctl.c
+++ b/bsd/kern/kern_sysctl.c
@@ -2361,6 +2361,21 @@ sysctl_sysctl_bootargs
 	char buf[BOOT_LINE_LENGTH];
 
 	strlcpy(buf, PE_boot_args(), BOOT_LINE_LENGTH);
+	/*
+	 * renoir: the root is a RAM disk (rd=mdN), and iOS 26's launchd takes "rd=md0" in the boot-args
+	 * for the restore environment: it then runs only the restore boot tasks (no keybagd --init, no
+	 * usermanagerd --init, so no persona manifest and no personas) and every daemon that needs them
+	 * waits. The kernel has found its root already; user space is shown the line without that word.
+	 */
+	for (char *w = buf; (w = strnstr(w, "rd=md", (size_t)(buf + sizeof(buf) - w))) != NULL;) {
+		if (w == buf || w[-1] == ' ') {
+			while (*w != '\0' && *w != ' ') {
+				*w++ = ' ';
+			}
+		} else {
+			w++;
+		}
+	}
 	error = sysctl_io_string(req, buf, BOOT_LINE_LENGTH, 0, NULL);
 	return error;
 }
