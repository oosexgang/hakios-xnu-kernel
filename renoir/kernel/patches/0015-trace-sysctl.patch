diff --git a/bsd/kern/kern_newsysctl.c b/bsd/kern/kern_newsysctl.c
index 20d071c..ef3af14 100644
--- a/bsd/kern/kern_newsysctl.c
+++ b/bsd/kern/kern_newsysctl.c
@@ -1159,6 +1159,27 @@ name2oid(char *name, int *oid, size_t *len)
 	return ENOENT;
 }
 
+/*
+ * renoir: boot-arg trace_sysctl=1 logs the names a process asks for that this kernel has not got
+ * ("sysctl: launchd[1] has no security.mac.foo"), the first 300 of them: a newer userland than the
+ * kernel looks up sysctls the kernel never had, and often abort()s on the answer.
+ */
+static void
+sysctl_trace_missing(const char *name)
+{
+	static int enabled = -1;
+	static uint32_t lines;
+	int on = 0;
+
+	if (enabled < 0) {
+		enabled = PE_parse_boot_argn("trace_sysctl", &on, sizeof(on)) && on != 0;
+	}
+	if (!enabled || os_atomic_inc_orig(&lines, relaxed) >= 300) {
+		return;
+	}
+	printf("sysctl: %s[%d] has no %s\n", proc_best_name(current_proc()), proc_pid(current_proc()), name);
+}
+
 /*
  * sysctl_sysctl_name2oid
  *
@@ -1234,6 +1255,9 @@ sysctl_sysctl_name2oid(__unused struct sysctl_oid *oidp, __unused void *arg1,
 	error = name2oid(p, oid, &len);
 	lck_rw_done(&sysctl_geometry_lock);
 
+	if (error) {
+		sysctl_trace_missing(p);
+	}
 	kfree_data(p, req->newlen + 1);
 
 	if (error) {
@@ -1753,6 +1777,7 @@ sysctl_root(boolean_t from_kernel, boolean_t string_is_canonical,
 		/* namestring is actually canonical, name/namelen needs to be populated */
 		error = name2oid(namestring, name, &namelen);
 		if (error) {
+			sysctl_trace_missing(namestring);
 			goto err;
 		}
 	}
