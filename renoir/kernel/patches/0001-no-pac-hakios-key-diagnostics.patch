 	thread_call_enter_delayed(hv_wdt_call, deadline);
diff --git a/osfmk/arm64/sleh.c b/osfmk/arm64/sleh.c
index cd1c2a6..1683c92 100644
--- a/osfmk/arm64/sleh.c
+++ b/osfmk/arm64/sleh.c
@@ -811,9 +811,11 @@ sleh_synchronous(arm_context_t *context, uint64_t esr, vm_offset_t far, __unused
 		static uint32_t hk_user_faults;
 		if (hk_user_faults++ < 16) {
 			char line[200];
-			uint64_t ia, ga;
+			uint64_t ia = 0, ga = 0;
+#if HAS_STD_PAC        /* renoir: no key registers on an ARMv8.2 core */
 			__asm__ volatile ("mrs %0, APIAKeyLo_EL1" : "=r" (ia));
 			__asm__ volatile ("mrs %0, APGAKeyLo_EL1" : "=r" (ga));
+#endif
 			snprintf(line, sizeof(line), "hakios: user exception esr=0x%llx far=0x%lx pc=0x%llx lr=0x%llx sp=0x%llx iaLo=%llx\n",
 			    esr, far, get_saved_state_pc(state), get_saved_state_lr(state), get_saved_state_sp(state), ia);
 			loader_log_line(line);
