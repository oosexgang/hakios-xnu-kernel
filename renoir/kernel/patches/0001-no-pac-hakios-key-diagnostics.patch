diff --git a/osfmk/arm64/loader_return.c b/osfmk/arm64/loader_return.c
index b879367..571098b 100644
--- a/osfmk/arm64/loader_return.c
+++ b/osfmk/arm64/loader_return.c
@@ -800,10 +800,12 @@ hv_wdt_pet(__unused thread_call_param_t p0, __unused thread_call_param_t p1)
 	if (++loader_live.heartbeat % MEMORY_REPORT_BEATS == 0) {
 		memory_report();
 	}
+#if HAS_STD_PAC
 	if (loader_live.heartbeat == 1) {
 		extern void hk_ib_report(const char *where);
 		hk_ib_report("first heartbeat");
 	}
+#endif
 
