.DS_Store
__pycache__/
*.o
*.dylib
*.efi
*.bin
*.mbn
*.dtb
*.ipsw
*.apfs
*.metallib
tools/export.local
darwin/tools/a64census
darwin/tools/pacstrip
darwin/userland/obj26/
darwin/userland/obj27/
*.obj

# what tools/boards.py gen writes (the tables the code is built with, for the boards that are there)
/build/
# the userland's own builds
/userland/build/
# Metal's builds (components/metal/tools/air/mk-host.sh: Mesa for this machine; mk-mesa26-linux.sh, mk-metal-linux.sh)
/components/metal/build
# device packages brought in with tools/device.py: they are kept on the devices branch, not here
/devices/*/
!/devices/_template/
!/devices/qemu-virt/
qemu-kernel.log

# the package manager's prefix userland/tools/mk-jb.sh fetches (Procursus, Sileo, ElleKit): somebody else's packages
/userland/jb/

# a phone's own files, taken from it or built from its firmware (loader/mkboot.py, Documentation/porting.md): never published
/firmware/

# what bench makes and fetches: its logs, the images it sends
/logs/
/resident.img
/usb-payload.bin
/run-payload.bin

# made by loader/build.sh from the device tree of your own IPSW (loader/mkidentity.py): Apple's data
/loader/identity.h
