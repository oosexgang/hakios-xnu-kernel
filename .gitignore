# A whitelist: the working tree also holds gigabytes of downloads, build output, logs, third-party
# clones and files of Darwin, none of which belongs in the repository. Nothing is tracked unless it
# is named here.
/*
!/.gitignore
!/.gitattributes
!/VERSION
!/README.md
!/CONTRIBUTING.md
!/CHANGELOG.md
!/ci/
!/configs/
!/README.uk.md
!/README.zh.md
!/Makefile
!/LICENSE
!/LICENSE.APSL
!/NOTICE
!/LEGAL.md
!/COMMUNITY.md
!/COMPLIANCE.md
!/THIRD_PARTY_LICENSES.md
!/devices/
!/socs/
!/mtk/
!/drivers/
!/docs/
!/xl
!/mkxnuimg.py
!/xnu-build.sh
!/xnu-env.sh
!/xnuloader/
!/qemu/
!/tools/
!/userland/
!/sysimage/
!/xnu/
!/xnu-deps/
!/prebuilt/
!/wifi/

__pycache__/
*~
*.orig
*.rej

/xnuloader/*
!/xnuloader/build.sh
!/xnuloader/efi.h
!/xnuloader/loader.c
!/xnuloader/mkidentity.py
!/xnuloader/mkpayload.py

/qemu/*
!/qemu/*.sh
!/qemu/*.py

/userland/*
!/userland/build.sh
!/userland/*.py
!/userland/rc.*
!/userland/com.hakios.*.plist
!/userland/src/
!/userland/libmini/
!/userland/var/

/sysimage/*
!/sysimage/unpack.sh
!/sysimage/*.py

# of xnu-deps only what is ours; setup.sh fetches and builds the rest
/xnu-deps/*
!/xnu-deps/setup.sh
!/xnu-deps/gen-iig-stubs.py
!/xnu-deps/hostinc/
# ... but not Apple's Mach-O headers in it: setup.sh copies them from the kernel tree
/xnu-deps/hostinc/mach-o/loader.h
/xnu-deps/hostinc/mach-o/nlist.h
/xnu-deps/hostinc/mach-o/fat.h
!/xnu-deps/iig-impl/
!/xnu-deps/host/
/xnu-deps/host/*
!/xnu-deps/host/bin/
/xnu-deps/host/bin/*
!/xnu-deps/host/bin/codesign
!/xnu-deps/host/bin/iig
!/xnu-deps/host/bin/install
!/xnu-deps/host/bin/plutil
!/xnu-deps/host/bin/sw_vers
!/xnu-deps/host/bin/xcrun
!/xnu-deps/host/bin/xnu-clang
!/xnu-deps/build/
/xnu-deps/build/*
!/xnu-deps/build/pthread/
/xnu-deps/build/pthread/*
!/xnu-deps/build/pthread/build.sh
!/xnu-deps/build/pthread/inc/
!/xnu-deps/build/lzbitmap/
/xnu-deps/build/lzbitmap/*
!/xnu-deps/build/lzbitmap/unzbm.c
!/xnu-deps/build/lzbitmap/libzbitmap.c
!/xnu-deps/build/lzbitmap/libzbitmap.h
/tools/android/f2fs-resize
/tools/macos-bin/platform-tools/

# made at build time from the device tree of the builder's own IPSW (xnuloader/mkidentity.sh)
/xnuloader/identity.h
!/xnuloader/im4p.py
!/xnuloader/mkidentity.sh

# the phone vendor's UEFI drivers, and the UEFI image built with them: proprietary, so never tracked. They
# stay on the disk of whoever extracted them from their own phone (uefi/README.md).
/devices/*/uefi/files/Binaries/*/*
!/devices/*/uefi/files/Binaries/*/README.md
/devices/*/prebuilt/SILICIUM_UEFI.fd

# The SoC, device and UEFI repositories that tools/hakios-device.py sync clones into place (devices/manifest.conf) are their own:
/socs/*
!/socs/README.md
/devices/*
!/devices/manifest.conf
!/devices/README.md
!/devices/qemu/
!/devices/light/

# Android platform-tools for xl on a Mac (tools/macos-bin/README.md): not part of the repository
/tools/macos-bin/platform-tools
/xnu-deps/hostinc/uuid
