# A whitelist: the working tree also holds gigabytes of downloads, build output, logs, third-party
# clones and files of iOS, none of which belongs in the repository. Nothing is tracked unless it
# is named here.
/*
!/.gitignore
!/README.md
!/README.ru.md
!/docs/
!/xl
!/xl_x6826b
!/mkpackfs.py
!/mkxnuimg.py
!/mkxnuimg_x6826b.py
!/xnu-build.sh
!/xnu-env.sh
!/xnuloader/
!/mtkloader/
!/qemu/
!/tools/
!/userland/
!/ios165/
!/xnu/
!/xnu-deps/
!/uefi/
!/prebuilt/
!/wifi/

__pycache__/
.DS_Store
*~
*.orig
*.rej

/xnuloader/*
!/xnuloader/build.sh
!/xnuloader/efi.h
!/xnuloader/identity.h
!/xnuloader/loader.c
!/xnuloader/mkidentity.py
!/xnuloader/mkpayload.py

/qemu/*
!/qemu/*.sh
!/qemu/*.py

/userland/*
!/userland/build.sh
!/userland/*.py
!/userland/rc.*
!/userland/com.redwood.*.plist
!/userland/src/
!/userland/libmini/
!/userland/var/
!/userland/share/

/ios165/*
!/ios165/fetch.sh
!/ios165/*.py

# of xnu-deps only what is ours; setup.sh fetches and builds the rest
/xnu-deps/*
!/xnu-deps/setup.sh
!/xnu-deps/gen-iig-stubs.py
!/xnu-deps/hostinc/
!/xnu-deps/iig-impl/
!/xnu-deps/host/
/xnu-deps/host/*
!/xnu-deps/host/bin/
/xnu-deps/host/bin/*
!/xnu-deps/host/bin/codesign
!/xnu-deps/host/bin/iig
!/xnu-deps/host/bin/install
!/xnu-deps/host/bin/plutil
!/xnu-deps/host/bin/python
!/xnu-deps/host/bin/sw_vers
!/xnu-deps/host/bin/xcrun
!/xnu-deps/host/bin/xnu-clang
!/xnu-deps/build/
/xnu-deps/build/*
!/xnu-deps/build/pthread/
/xnu-deps/build/pthread/*
!/xnu-deps/build/pthread/build.sh
!/xnu-deps/build/pthread/inc/
!/xnu-deps/build/lzbitmap/
/xnu-deps/build/lzbitmap/*
!/xnu-deps/build/lzbitmap/unzbm.c
!/xnu-deps/build/lzbitmap/libzbitmap.c
!/xnu-deps/build/lzbitmap/libzbitmap.h
/tools/android/f2fs-resize

# build output of the bare-metal loader
/mtkloader/*.bin
/mtkloader/*.bin.gz
/mtkloader/*.gz
/mtkloader/*.o
/mtkloader/*.elf
/mtkloader/*.img

# Nothing of Apple's and nothing of a vendor's, wherever it would land (the rules of the oosexgang
# organisation, LEGAL.md there): no picture of iOS (screenshots, photographs of the screen), no
# firmware, no image or device tree taken off a phone, no IPSW or anything out of one. The docs
# describe what the screen showed in words; firmware is pulled from the user's own phone.
*.png
*.jpg
*.jpeg
*.heic
*.gif
*.mp4
*.mov
*.ipsw
*.dmg
*.metallib
*.dylib
*.dtb
*.fd
*.img
*.bin
*.ko
*.apfs
*.zst
fw-*/
/userland/share/*
# (the user space libraries the build makes, the one binary kind kept: built from this repository)
!/prebuilt/userland/*.dylib
!/userland/rc.*
# (but the pipeline recipes backboardd builds at start: CoreAnimation's pipeline labels, shader function names
# and blend/vertex layouts, as numbers -- tools/rwm-recipes.py, src/redwoodmetal.m)
!/userland/share/rwm-recipes.txt
