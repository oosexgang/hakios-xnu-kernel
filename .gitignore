.DS_Store
__pycache__/
*.o
*.dylib
*.efi
*.bin
*.mbn
*.dtb
*.ipsw
*.apfs
*.metallib
tools/export.local
arch/arm64/tools/a64census
arch/arm64/tools/pacstrip
darwin/userland/obj26/
darwin/userland/obj27/
*.obj

# what tools/boards.py gen writes (the tables the code is built with, for the boards that are there)
/build/
# the userland's own builds
/userland/build/
# Metal's builds (components/metal/tools/air/mk-host.sh: Mesa for this machine; mk-mesa26-linux.sh, mk-metal-linux.sh)
/components/metal/build
# device packages brought in with tools/device.py: they are kept on the devices branch, not here
/arch/arm64/boot/dts/*/
!/arch/arm64/boot/dts/_template/
!/arch/arm64/boot/dts/qemu-virt/
/devices/
qemu-kernel.log

# the package manager's prefix components/tweaks/tools/mk-jb.sh fetches (Procursus, Sileo, ElleKit): somebody else's packages
/components/tweaks/jb/

# a phone's own files, taken from it or built from its firmware (arch/arm64/boot/mkboot.py, Documentation/porting.md): never published
/firmware/*
!/firmware/README.md
# ... and the vendor's firmware userland/userland/build.sh puts into the small image (userland/README.md): fw-gpu, fw-wifi,
# fw-audio, fw-haptic, fw-bt, fw-camera beside it
/userland/fw-*/

# what bench makes and fetches: its logs, the images it sends
/logs/
/resident.img
/usb-payload.bin
/run-payload.bin
/run-identity.bin

# made by arch/arm64/boot/build.sh from the device tree of your own IPSW (arch/arm64/boot/mkidentity.py): Apple's data
/arch/arm64/boot/identity.h
