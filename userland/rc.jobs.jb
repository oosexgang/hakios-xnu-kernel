# Commands run by the launchd job com.redwood.demo (see com.redwood.demo.plist).
# The package manager for a person to use (RC_JOBS=rc.jobs.jb): nothing pressed by a script -- the
# preparation the bootstrap wants once per boot, the network, a fresh index, and the phone is yours
# for the session (XL_SECS). What is installed lives in memory, as all of /private/var: gone at the
# next boot.
/redwood/bin/sound_test springboard
/var/jb/bin/sh /var/jb/prep.sh
/redwood/bin/net_test waitaddr en0 60 resolve apt.procurs.us
/var/jb/usr/bin/apt-get update
