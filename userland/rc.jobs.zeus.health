# The zeus RAM / heat / battery health check (devices/zeus/README.md "Memory", "Heat", "Battery health"): how much memory
# Darwin got, the sensors, the brake and the pressure level iOS sees, under a load of every core; the battery as powerd
# has it, and Settings > Battery > Battery Health on the screen (xl screenshot while it is up).
/redwood/bin/thermal_notify status
/redwood/bin/battery_test health
/redwood/bin/sound_test springboard
/redwood/bin/rwtouch wait 20 swipe 0.5 0.985 0.5 0.3 250 wait 6
/redwood/bin/battery_test
/redwood/bin/battery_test health
/redwood/bin/battery_test open prefs:root=BATTERY_USAGE&path=BATTERY_HEALTH
/redwood/bin/rwtouch wait 12
/redwood/bin/thermal_notify status
/redwood/bin/rwtouch wait 25 button home wait 3
/redwood/bin/thermal_notify load 150
/redwood/bin/rwtouch wait 30
/redwood/bin/thermal_notify status
/redwood/bin/battery_test
/redwood/bin/battery_test health
