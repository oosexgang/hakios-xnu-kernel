# iOS 26/27 (RC_JOBS=ios/userland/rc.jobs.unlock root26-ios.sh): the default list's network, then the lock
# screen swiped up as a finger does, once SpringBoard has had time to draw it; the home screen stays
/redwood/bin/net_test wifi
/redwood/bin/rwtouch wait 100 swipe 0.5 0.985 0.5 0.3 200
/bin/ps -A
/redwood/bin/net_test waitaddr en0 60
/bin/ps -A
