#!/bin/bash
# LLVM's Mach-O linker in the place of cctools' ld64, for a build without theos' toolchain
# (kernel/build.sh: TOOLCHAIN=llvm). Two differences matter to XNU's link and are made up for here:
# ld64.lld wants the platform said where ld64 takes it from the objects, and it takes aliases one by
# one (-alias OLD NEW) where XNU gives ld64 a file of them (-alias_list FILE: vm_map for
# vm_map_external and the like).
args=(-platform_version ios "${XNU_SDK_VERSION:-16.5}" "${XNU_SDK_VERSION:-16.5}")
while [ $# -gt 0 ]; do
	if [ "$1" = -alias_list ]; then
		while read -r from to _; do
			[ -n "$from" ] && args+=(-alias "$from" "$to")
		done < "${2:?-alias_list needs a file}"
		shift 2
	else
		args+=("$1")
		shift
	fi
done
exec "${XNU_CLANG_DIR:?XNU_CLANG_DIR: the directory of clang and ld64.lld}/ld64.lld" "${args[@]}"
