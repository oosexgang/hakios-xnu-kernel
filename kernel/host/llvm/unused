#!/bin/bash
# nmedit, ctf_insert, codesign_allocate in a build without theos' toolchain (kernel/build.sh:
# TOOLCHAIN=llvm). XNU's makefiles look each up when they start; the kernel the build makes uses none
# of them (the kext symbol sets are not built, CTF is off, the signature is kernel/deps' no-op). One
# that is called after all says so and fails, instead of doing nothing quietly.
echo "$(basename "$0"): not part of a build with LLVM's tools (called with: $*)" >&2
exit 1
