+
+#if HAS_STD_PAC        /* hakios: pacib and the key registers do not exist on an ARMv8.2 core */
+/*
+ * hakios: the IB key a core really uses, before and after rewriting TTBR0 (which the hypervisor may
+ * trap): pacib of a fixed value is its fingerprint, the register read-back what the core claims. A
+ * leaf function, so that it signs no return address of its own across the write.
+ */
+struct hk_ibprobe { uint64_t before, after, reg_before, reg_after, cpacr, ttbr; };
+static void __attribute__((noinline))
+hk_ib_probe(struct hk_ibprobe *r)
+{
+	uint64_t v, ttbr;
+
+	__asm__ volatile ("mrs %0, cpacr_el1" : "=r" (r->cpacr));
+	v = 0xfffffff007004000ULL;
+	__asm__ volatile (".arch_extension pauth\n pacib %0, %1" : "+r" (v) : "r" (0x1234ULL));
+	r->before = v;
+	__asm__ volatile ("mrs %0, APIBKeyLo_EL1" : "=r" (r->reg_before));
+	__asm__ volatile ("mrs %0, ttbr0_el1\n msr ttbr0_el1, %0\n isb" : "=r" (ttbr) : : "memory");
+	r->ttbr = ttbr;
+	v = 0xfffffff007004000ULL;
+	__asm__ volatile ("pacib %0, %1" : "+r" (v) : "r" (0x1234ULL));
+	r->after = v;
+	__asm__ volatile ("mrs %0, APIBKeyLo_EL1" : "=r" (r->reg_after));
+}
+
+extern void loader_log_line(const char *line);
+
+/* no printf: on a core whose CPACR is not what was written, varargs (SIMD registers) trap */
+static char *
+hk_hex(char *o, uint64_t v)
+{
+	for (int i = 60; i >= 0; i -= 4) {
+		*o++ = "0123456789abcdef"[(v >> i) & 15];
+	}
+	*o++ = ' ';
+	return o;
+}
+
+void hk_ib_report(const char *where);
+void
+hk_ib_report(const char *where)
+{
+	struct hk_ibprobe r;
+	char line[200], *o = line;
+	const char *prefix = "hakios: ib ";
+
+	hk_ib_probe(&r);
+	while (*prefix) {
+		*o++ = *prefix++;
+	}
+	while (*where && o < line + 40) {
+		*o++ = *where++;
+	}
+	*o++ = ' ';
+	*o++ = (char)('0' + cpu_number());
+	*o++ = ' ';
+	o = hk_hex(o, r.before);
+	o = hk_hex(o, r.after);
+	o = hk_hex(o, r.reg_before);
+	o = hk_hex(o, r.reg_after);
+	o = hk_hex(o, r.cpacr);
+	o = hk_hex(o, r.ttbr);
+	*o++ = '\n';
+	*o = 0;
+	loader_log_line(line);
+}
+#endif /* HAS_STD_PAC */
