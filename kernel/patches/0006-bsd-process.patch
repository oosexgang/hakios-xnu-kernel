+/* the floor under the memory limits of a few of the system's daemons (memory_floor.h), boot-arg memfloor=MB */
+static TUNABLE(uint32_t, memory_floor_mb, "memfloor", MEMORY_FLOOR_DEFAULT_MB);
+
+static const char *
+memory_floor_name(proc_t p)
+{
+	return p->p_name[0] != 0 ? p->p_name : p->p_comm;
+}
+
+/* the limits launchd gives with the spawn of one of them */
+static void
+memory_floor_given(proc_t p, int32_t *active, int32_t *inactive)
+{
+	int32_t active_was = *active, inactive_was = *inactive;
+
+	if (memory_floor_raise(memory_floor_name(p), (int32_t)memory_floor_mb, active, inactive)) {
+		printf("memfloor: %s[%d]: its limits, %d MB active and %d MB inactive, raised to %d and %d MB\n",
+		    memory_floor_name(p), proc_getpid(p), active_was, inactive_was, *active, *inactive);
+	}
+}
+
+/*
+ * the limits a process keeps when it becomes one of them by an exec -- xpcproxy, which launchd spawned with the
+ * daemon's limits, and which then becomes the daemon
+ */
+static void
+memory_floor_kept(proc_t p)
+{
+	int32_t active = p->p_memstat_memlimit_active, inactive = p->p_memstat_memlimit_inactive;
+	int32_t active_was = active, inactive_was = inactive;
+	memlimit_options_t options = MEMLIMIT_OPTIONS_NONE;
+
+	if (!memory_floor_raise(memory_floor_name(p), (int32_t)memory_floor_mb, &active, &inactive)) {
+		return;
+	}
+	if (p->p_memstat_state & P_MEMSTAT_MEMLIMIT_ACTIVE_FATAL) {
+		options |= MEMLIMIT_ACTIVE_FATAL;
+	}
+	if (p->p_memstat_state & P_MEMSTAT_MEMLIMIT_INACTIVE_FATAL) {
+		options |= MEMLIMIT_INACTIVE_FATAL;
+	}
+	memorystatus_set_memlimits(p, active, inactive, options);
+	printf("memfloor: %s[%d]: the limits it came with, %d MB active and %d MB inactive, raised to %d and %d MB\n",
+	    memory_floor_name(p), proc_getpid(p), active_was, inactive_was, active, inactive);
+}
 #endif
 
