+/*
+ * hakios: boot-arg trace_open=name[,name...] (p_comm) puts every path such a process looks up --
+ * open, stat, access, getattrlist all come through here -- and what came of it into the loader's log,
+ * to see which file a daemon looks for and does not find. At most 400 lines a boot.
+ */
 int
 namei(struct nameidata *ndp)
+{
+	static char wanted[96], only[64];
+	static int parsed, lines;
+	char path[160] = "";
+	const char *name = NULL;
+	int error;
+
+	if (!parsed) {
+		parsed = 1;
+		if (!PE_parse_boot_arg_str("trace_open", wanted, sizeof(wanted))) {
+			wanted[0] = '\0';
+		}
+		/* hakios: trace_open_path=SUBSTRING, only the paths with it (the 400 lines go further) */
+		if (!PE_parse_boot_arg_str("trace_open_path", only, sizeof(only))) {
+			only[0] = '\0';
+		}
+	}
+	if (wanted[0] != '\0' && lines < 400) {
+		proc_t p = current_proc();
+
+		name = p != NULL ? proc_best_name(p) : NULL;
+		if (name != NULL && name[0] != '\0' && strnstr(wanted, name, sizeof(wanted)) != NULL) {
+			size_t got = 0;
+
+			if (UIO_SEG_IS_USER_SPACE(ndp->ni_segflg)) {
+				(void)copyinstr(ndp->ni_dirp, path, sizeof(path), &got);
+			} else {
+				(void)copystr(CAST_DOWN(void *, ndp->ni_dirp), path, sizeof(path), &got);
+			}
+			path[sizeof(path) - 1] = '\0';
+		} else {
+			name = NULL;
+		}
+	}
+	if (name != NULL && only[0] != '\0' && strnstr(path, only, sizeof(path)) == NULL) {
+		name = NULL;
+	}
+	error = namei_untraced(ndp);
+	if (name != NULL && lines < 400) {
+		extern void loader_log_line(const char *line);
+		char line[220];
+
+		lines++;
+		snprintf(line, sizeof(line), "hakios: open %s[%d] %s -> %d\n", name, proc_selfpid(), path, error);
+		loader_log_line(line);
+	}
+	return error;
+}
